# Frontend Public Environment Variables (Safe to expose to browser)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend / Supabase Edge Function Secrets (NEVER expose to frontend or git)
# Configure in Supabase CLI via: npx supabase secrets set GEMINI_API_KEY=your_key
GEMINI_API_KEY=your-google-gemini-api-key-here
